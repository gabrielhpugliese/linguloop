# https://console.cloud.google.com/apis/credentials?project=linguloop
YOUTUBE_API_KEY=

# --- Google AdSense (optional; ads and ads.txt stay off while the client ID is empty) ---
# NEXT_PUBLIC_* values are baked in at build time: redeploy after changing them.
# Publisher ID from AdSense > Account > Settings, e.g. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=
# Ad unit IDs (AdSense > Ads > By ad unit > Display ads, responsive); digits only
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
